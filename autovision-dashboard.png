<svg width="1200" height="380" viewBox="0 0 1200 380" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="AutoVision AI hero banner">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1200" y2="380" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#0B1020"/>
      <stop offset="0.55" stop-color="#111938"/>
      <stop offset="1" stop-color="#0E1B33"/>
    </linearGradient>
    <linearGradient id="title" x1="80" y1="120" x2="640" y2="220" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#67E8F9"/>
      <stop offset="0.5" stop-color="#818CF8"/>
      <stop offset="1" stop-color="#C084FC"/>
    </linearGradient>
    <linearGradient id="car" x1="820" y1="150" x2="1080" y2="300" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#22D3EE"/>
      <stop offset="1" stop-color="#818CF8"/>
    </linearGradient>
    <radialGradient id="glow" cx="0.75" cy="0.5" r="0.6">
      <stop offset="0" stop-color="#818CF8" stop-opacity="0.35"/>
      <stop offset="1" stop-color="#818CF8" stop-opacity="0"/>
    </radialGradient>
    <pattern id="grid" width="34" height="34" patternUnits="userSpaceOnUse">
      <path d="M34 0H0V34" fill="none" stroke="#2A3A63" stroke-width="1" stroke-opacity="0.35"/>
    </pattern>
  </defs>

  <rect width="1200" height="380" rx="18" fill="url(#bg)"/>
  <rect width="1200" height="380" rx="18" fill="url(#grid)"/>
  <rect width="1200" height="380" rx="18" fill="url(#glow)"/>
  <rect x="1" y="1" width="1198" height="378" rx="17" fill="none" stroke="#2E3E68" stroke-width="1.5"/>

  <!-- Left content -->
  <g font-family="'Segoe UI', Helvetica, Arial, sans-serif">
    <g transform="translate(80,70)">
      <rect x="0" y="0" width="150" height="30" rx="15" fill="#182444" stroke="#3B4C7A"/>
      <circle cx="20" cy="15" r="4" fill="#34D399"/>
      <text x="34" y="20" fill="#9FB3E0" font-size="13" font-weight="600" letter-spacing="1">COMPUTER VISION</text>
    </g>

    <text x="80" y="185" fill="url(#title)" font-size="74" font-weight="800" letter-spacing="-1">AutoVision AI</text>

    <text x="82" y="228" fill="#C7D2FE" font-size="21" font-weight="600">Vehicle Make · Model · Year-Range Recognition</text>

    <text x="82" y="262" fill="#8595BD" font-size="15">Upload a car image → get manufacturer, model, year range,</text>
    <text x="82" y="284" fill="#8595BD" font-size="15">confidence and closest alternative matches.</text>

    <!-- tech pills -->
    <g transform="translate(80,308)" font-size="13" font-weight="600" fill="#CBD5F5">
      <g><rect width="66" height="28" rx="14" fill="#122A3A" stroke="#1F5066"/><text x="33" y="19" text-anchor="middle" fill="#67E8F9">CLIP</text></g>
      <g transform="translate(76,0)"><rect width="118" height="28" rx="14" fill="#1B2350" stroke="#3A4787"/><text x="59" y="19" text-anchor="middle" fill="#A5B4FC">MobileNetV2</text></g>
      <g transform="translate(204,0)"><rect width="86" height="28" rx="14" fill="#241C40" stroke="#4B3A78"/><text x="43" y="19" text-anchor="middle" fill="#C4B5FD">Streamlit</text></g>
      <g transform="translate(300,0)"><rect width="72" height="28" rx="14" fill="#0F2A22" stroke="#1E5F49"/><text x="36" y="19" text-anchor="middle" fill="#6EE7B7">Python</text></g>
    </g>
  </g>

  <!-- Right: stylized car + scan -->
  <g transform="translate(760,120)">
    <ellipse cx="180" cy="180" rx="185" ry="42" fill="#0A1226" opacity="0.7"/>
    <!-- scan brackets -->
    <g stroke="#34D399" stroke-width="3" fill="none" opacity="0.9">
      <path d="M20 30 H0 V50"/>
      <path d="M340 30 H360 V50"/>
      <path d="M20 150 H0 V130"/>
      <path d="M340 150 H360 V130"/>
    </g>
    <!-- car body -->
    <path d="M35 130 Q55 78 110 72 L150 60 Q210 50 250 74 L300 92 Q330 100 335 128 L336 150 Q336 158 328 158 L44 158 Q34 158 35 148 Z" fill="url(#car)"/>
    <path d="M120 74 L150 62 Q205 54 240 74 L255 90 L120 90 Z" fill="#0B1020" opacity="0.55"/>
    <line x1="185" y1="74" x2="185" y2="90" stroke="#0B1020" stroke-width="3" opacity="0.55"/>
    <!-- wheels -->
    <circle cx="105" cy="158" r="26" fill="#0B1020" stroke="#22D3EE" stroke-width="4"/>
    <circle cx="105" cy="158" r="9" fill="#1E293B"/>
    <circle cx="270" cy="158" r="26" fill="#0B1020" stroke="#818CF8" stroke-width="4"/>
    <circle cx="270" cy="158" r="9" fill="#1E293B"/>
    <!-- detection tag -->
    <g transform="translate(228,20)">
      <rect width="128" height="26" rx="6" fill="#0E1B33" stroke="#34D399"/>
      <circle cx="14" cy="13" r="4" fill="#34D399"/>
      <text x="26" y="17" fill="#A7F3D0" font-size="12" font-weight="700" font-family="'Segoe UI', Arial, sans-serif">98% match</text>
    </g>
  </g>
</svg>
